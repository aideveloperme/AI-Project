     "placement": "bottom"
    },
    "tooltip": {
     "mode": "single"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "DCGM_FI_DEV_SM_CLOCK{node=\"spark-01\"}",
     "legendFormat": "SM clock"
    }
   ]
  },
