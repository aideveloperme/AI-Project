  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Host CPU utilization (%)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "single"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{node=\"spark-01\",mode=\"idle\"}[1m])))",
     "legendFormat": "Host CPU utilization"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Host memory used (%)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "single"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 * (1 - node_memory_MemAvailable_bytes{node=\"spark-01\"} / node_memory_MemTotal_bytes{node=\"spark-01\"})",
     "legendFormat": "Host memory used"
    }
   ]
  },
