# ---------------------------------------------------------------------------
# Air-gapped AI stack for NVIDIA DGX Spark — configuration
# Copy to .env (scripts/install.sh does this for you) and adjust.
# ---------------------------------------------------------------------------

# Image versions. Pin them: the same tags are pulled by scripts/bundle.sh on the
# connected machine and loaded on the Spark, and bundle/MANIFEST.txt records digests.
OLLAMA_VERSION=0.40.3
OPEN_WEBUI_VERSION=v0.12.0
# Chroma server image tag AND the Python client version baked into rag-api.
# They must match, so change them together.
CHROMA_VERSION=1.5.9

# Host address the UI / API listen on.
#   127.0.0.1      -> reachable only from the Spark itself (SSH tunnel for others)
#   <Spark LAN IP> -> reachable from your isolated (air-gapped) LAN
BIND_ADDR=127.0.0.1
WEBUI_PORT=3000
RAG_API_PORT=8000

# Session-signing key for Open WebUI. install.sh replaces this with a random value.
WEBUI_SECRET_KEY=change-me

# Models (must be in models.txt so they get bundled)
DEFAULT_CHAT_MODEL=gpt-oss:20b
EMBED_MODEL=nomic-embed-text

# Ollama tuning. The Spark has 128 GB of unified memory, so keeping a couple of
# models resident and serving several requests in parallel is fine.
OLLAMA_KEEP_ALIVE=30m
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_NUM_PARALLEL=4
